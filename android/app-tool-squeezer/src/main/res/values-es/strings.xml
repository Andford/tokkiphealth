    <string name="squeezer_min_size_title">Tamaño mínimo</string>
    <string name="squeezer_min_size_description">Salta los archivos más chicos que esto.</string>
    <string name="squeezer_min_age_title">Antigüedad mínima</string>
    <string name="squeezer_min_age_description">Solo archivos más viejos que esto.</string>
    <string name="squeezer_compression_settings_label">General</string>
    <string name="squeezer_quality_description">Menos calidad deja archivos más chicos, pero se ven peor.</string>
    <string name="squeezer_types_category_label">Fotos</string>
    <string name="squeezer_protected_category_label">Lo que se pierde</string>
    <string name="squeezer_video_settings_category_label">Videos</string>
    <string name="squeezer_type_jpeg_title">JPEG</string>
    <string name="squeezer_type_jpeg_description">Incluye fotos JPEG (.jpg, .jpeg). Se recomprimen con el codificador JPEG de Android. La fecha, la ubicación y demás datos EXIF se conservan.</string>
    <string name="squeezer_type_webp_title">WebP</string>
    <string name="squeezer_type_webp_description">Incluye imágenes WebP (.webp). Se recomprimen con el codificador WebP de Android. La fecha, la ubicación y demás datos EXIF se conservan.</string>
    <string name="squeezer_type_heic_title">HEIC/HEIF</string>
    <string name="squeezer_type_heic_description">Incluye fotos HEIC/HEIF (.heic, .heif). La fecha, la ubicación y demás datos EXIF se conservan. Los mapas HDR, los datos de profundidad y las fotos en movimiento no se pueden conservar; los archivos con varias imágenes se saltan.</string>
    <string name="squeezer_type_video_title">Video MP4</string>
    <string name="squeezer_type_video_description">Incluye videos MP4 (.mp4). La imagen se recomprime a menor calidad con el codificador del teléfono, el audio se copia igual y el archivo sigue siendo MP4.</string>
    <string name="squeezer_skip_compressed_title">Saltar lo ya comprimido</string>
    <string name="squeezer_skip_compressed_description">Salta los archivos que Tokkip Health ya comprimió.</string>
    <string name="squeezer_exif_marker_title">Marcar en el EXIF</string>
    <string name="squeezer_exif_marker_description">Agrega una marca al comentario EXIF de la foto para no volver a comprimirla aunque se borre el historial.</string>
    <string name="squeezer_include_lossy_aux_title">Comprimir fotos HDR y con profundidad</string>
    <string name="squeezer_include_lossy_aux_description">Incluye fotos con HDR o datos de profundidad. Al comprimirlas se pierden: las HDR quedan como fotos normales y las de retrato pierden los datos de su fondo desenfocado. Los HEIC con varias imágenes se siguen saltando.</string>
    <string name="squeezer_include_motion_photos_title">Comprimir fotos en movimiento</string>
    <string name="squeezer_include_motion_photos_description">Incluye fotos en movimiento. Al comprimirlas se queda la foto y se quita el clip de video.</string>
    <string name="squeezer_include_oversized_title">Comprimir fotos enormes</string>
    <string name="squeezer_include_oversized_description">Incluye fotos de 8192 píxeles o más de ancho o alto. Se reducen a la mitad, y otra vez si hace falta, hasta quedar debajo de 8192 píxeles.</string>
